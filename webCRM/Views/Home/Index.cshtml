@{
    ViewData["Title"] = "ข้อมูลสัญญา";
    ViewData["HeaderTitle"] = "ข้อมูลสัญญา";
    ViewData["HideSidebar"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}

<div class="pc-wrapper">
    <div class="pc-tab-content active" id="tab3">
        <div class="pc-report-wrapper">
            <!-- Filter Bar -->
            <div class="pc-card p-4 flex-shrink-0">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">บริษัท</label>
                        <select class="form-select form-select-sm select2-filter" id="dashboardCompany">
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">สาขา</label>
                        <select class="form-select form-select-sm select2-filter" id="dashboardBranch" disabled>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">ประเภทลูกค้า</label>
                        <select class="form-select form-select-sm select2-filter" id="dashboardCustomerType" disabled>

                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">เพศ</label>
                        <select class="form-select form-select-sm select2-filter" id="dashboardGender" disabled>

                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">สถานะสัญญา</label>
                        <select class="form-select form-select-sm select2-filter" id="dashboardContactStatus" disabled>

                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3 justify-content-start">
                    <button class="btn btn-primary btn-sm px-3" id="dashboardSearch"><i class="bi bi-search me-2"></i>ค้นหา</button>
                    <button class="btn btn-outline-secondary btn-sm px-3" id="dashboardClear"><i class="bi bi-arrow-counterclockwise me-2"></i>ล้างตัวกรอง</button>
                </div>

            </div>

            @* การ์ดจำนวนลูกค้า *@
            <div class="customer-stats-grid">
                <!-- Card 1: ลูกค้าทั้งหมด -->
                <div class="customer-stat-card card-blue">
                    <div class="stat-card-main">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-title">สัญญาทั้งหมด</div>
                            <div class="stat-value-group">
                                <span class="stat-value" id="statTotalCount">0</span>
                                <span class="stat-unit">สัญญา</span>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <span>&nbsp;</span>
                    </div>
                </div>

                <!-- card บริษัท -->
                <div id="customerCard">
                </div>

            </div>

            <div class="customer-graph">

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="productChart"></canvas>
                    </div>
                </div>

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="occupationChart"></canvas>
                    </div>
                </div>

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="ageChart"></canvas>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CURRENT_COMPANY = '@(Context.Session.GetString("company") ?? "")';
        window.VARIABLE_FUNC = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("variable_func") ?? ""));
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/Home.js" asp-append-version="true"></script>
}
