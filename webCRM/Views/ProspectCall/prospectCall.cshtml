@{
    ViewData["Title"] = "ขายและติดตาม";
    ViewData["HeaderTitle"] = "รายละเอียด ขายและติดตาม";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productApprove.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prospectCall.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
}

<div class="pa-layout">
    <!-- Left Sidebar -->
    <div class="pa-sidebar-left">
        <div class="pa-sidebar-header">
            <h5>รายการขายและติดตาม</h5>
            <div class="badge-count" id="campaignCount">4</div>
        </div>

        <div class="pa-search-box">
            <div class="pa-search-input-group">
                <i class="bi bi-search"></i>
                <input type="text" id="campaignSearch" placeholder="ค้นหาแคมเปญ / รหัสแคมเปญ">
            </div>
        </div>

        <div class="campaign-list-container">
            <div class="pa-campaign-list">
                <div class="pa-card active" data-code="CMP-2024-0001">
                    <div class="pa-card-icon blue"><i class="bi bi-megaphone"></i></div>
                    <div class="pa-card-content">
                        <div class="pa-card-title-row">
                            <div class="pa-card-id">CMP-2024-0001</div>
                            <div class="pa-status-badge status-blue">กำลังดำเนินการ</div>
                        </div>
                        <div class="pa-card-name">โปรโมชัน ดอกเบี้ยพิเศษ 2.99%</div>
                        <div class="pa-card-date">วันที่เริ่ม: 01/05/2024 &bull; วันที่สิ้นสุด: 31/07/2024</div>
                    </div>
                </div>

                <div class="pa-card" data-code="CMP-2024-0002">
                    <div class="pa-card-icon green"><i class="bi bi-megaphone"></i></div>
                    <div class="pa-card-content">
                        <div class="pa-card-title-row">
                            <div class="pa-card-id">CMP-2024-0002</div>
                            <div class="pa-status-badge status-green">กำลังโทรออก</div>
                        </div>
                        <div class="pa-card-name">แคมเปญ ฟรีวันรับเงินคืน 1</div>
                        <div class="pa-card-date">วันที่เริ่ม: 15/05/2024 &bull; วันที่สิ้นสุด: 30/06/2024</div>
                    </div>
                </div>

                <div class="pa-card" data-code="CMP-2024-0003">
                    <div class="pa-card-icon yellow"><i class="bi bi-megaphone"></i></div>
                    <div class="pa-card-content">
                        <div class="pa-card-title-row">
                            <div class="pa-card-id">CMP-2024-0003</div>
                            <div class="pa-status-badge status-yellow">รอข้อมูลเพิ่มเติม</div>
                        </div>
                        <div class="pa-card-name">โปรโมชัน รีไฟแนนซ์ ดอกเบี้ยพิเศษ</div>
                        <div class="pa-card-date">วันที่เริ่ม: 01/06/2024 &bull; วันที่สิ้นสุด: 31/08/2024</div>
                    </div>
                </div>

                <div class="pa-card" data-code="CMP-2024-0004">
                    <div class="pa-card-icon purple"><i class="bi bi-megaphone"></i></div>
                    <div class="pa-card-content">
                        <div class="pa-card-title-row">
                            <div class="pa-card-id">CMP-2024-0004</div>
                            <div class="pa-status-badge status-purple">รออนุมัติ</div>
                        </div>
                        <div class="pa-card-name">โปรโมชัน ผ่อนสบาย 0% 6 เดือน</div>
                        <div class="pa-card-date">วันที่เริ่ม: 10/06/2024 &bull; วันที่สิ้นสุด: 10/09/2024</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Container -->
    <div class="pa-right-container">
        <!-- Content Wrapper (Main Area + Right Sidebar) -->
        <div class="pa-content-wrapper">

            <!-- Main Area -->
            <div class="pa-main-area">
                <!-- Top Section: Campaign Detail Header -->
                <div class="pa-section flex-shrink-0">
                    <div class="pa-section-title mb-3">
                        <i class="bi bi-megaphone"></i> รายละเอียด Product / Campaign
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4 col-xl-2 pa-form-group mb-0">
                            <label>รหัส Product / Campaign</label>
                            <input type="text" id="detailId" class="pa-form-control" value="CMP-2024-0001" readonly>
                        </div>
                        <div class="col-12 col-md-8 col-xl-4 pa-form-group mb-0">
                            <label>ชื่อ Product / Campaign</label>
                            <input type="text" id="detailName" class="pa-form-control" value="โปรโมชัน ดอกเบี้ยพิเศษ 2.99%" readonly>
                        </div>
                        <div class="col-12 col-md-6 col-xl-2 pa-form-group mb-0">
                            <label>วันที่เริ่มต้น</label>
                            <div class="pa-form-control-icon">
                                <input type="text" id="detailStart" class="pa-form-control" value="01/05/2024" readonly>
                                <i class="bi bi-calendar"></i>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-2 pa-form-group mb-0">
                            <label>วันที่สิ้นสุด</label>
                            <div class="pa-form-control-icon">
                                <input type="text" id="detailEnd" class="pa-form-control" value="31/07/2024" readonly>
                                <i class="bi bi-calendar"></i>
                            </div>
                        </div>
                        <div class="col-12 col-md-12 col-xl-2 pa-form-group mb-0">
                            <label>วัตถุประสงค์</label>
                            <input type="text" id="detailObjective" class="pa-form-control" value="ส่งเสริมการขายสินเชื่อ" readonly>
                        </div>
                    </div>
                </div>

                <!-- Bottom Section: Customer Table (Full Height) -->
                <div class="pc-prospect-section">
                    <div class="pa-prospect-header">
                        <div class="pa-section-title mb-0">
                            <i class="bi bi-people"></i> รายละเอียด Prospect / ลูกค้า
                        </div>
                        <div class="pa-table-controls" style="flex-grow: 1; max-width: 340px;">
                            <div class="pa-search-input-group" style="width: 100%;">
                                <i class="bi bi-search"></i>
                                <input type="text" id="prospectSearch" placeholder="ค้นหา ชื่อ-นามสกุล, เลขที่สัญญา, เบอร์โทร">
                            </div>
                        </div>
                    </div>

                    <!-- Table Wrapper (Scrollable Full Height) -->
                    <div class="pc-table-wrapper">
                        <table class="pc-prospect-table" id="prospectTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">ลำดับ</th>
                                    <th>บริษัท/สาขา</th>
                                    <th>ชื่อ-นามสกุล</th>
                                    <th>เลขที่สัญญา</th>
                                    <th>เบอร์โทร</th>
                                    <th>ใช้รถที่</th>
                                    <th>ผลการติดต่อ</th>
                                    <th>วันที่เลือกข้อมูล</th>
                                    <th>โดย</th>
                                </tr>
                            </thead>
                            <tbody id="prospectTableBody">
                                <!-- Loaded dynamically from JS array -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="pa-table-pagination mt-2">
                        <span id="prospectPaginationText">แสดง 1 - 8 จาก 8 รายการ</span>
                        <div class="d-flex align-items-center gap-3">
                            <div class="pa-page-controls">
                                <button class="pa-page-btn"><i class="bi bi-chevron-left"></i></button>
                                <button class="pa-page-btn active">1</button>
                                <button class="pa-page-btn"><i class="bi bi-chevron-right"></i></button>
                            </div>
                            <select class="pa-form-control" style="width: auto; padding: 0.25rem 2rem 0.25rem 0.75rem;">
                                <option>10 / หน้า</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Record Result Pop-up Modal -->
<div class="modal fade pc-modal" id="recordResultModal" tabindex="-1" aria-labelledby="recordResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="recordResultModalLabel">
                    <i class="bi bi-telephone-outbound me-2"></i>บันทึกผลการติดต่อลูกค้า
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Customer Summary Info Card -->
                <div class="pc-customer-info-card">
                    <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
                        <div>
                            <div class="text-muted small">ลูกค้าที่เลือก</div>
                            <div class="fw-bold text-dark fs-5" id="modalCustName">คุณณัฐวรรณ ใจดี</div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i><span id="modalCustPdpa">ยินยอมแล้ว (PDPA)</span>
                        </span>
                    </div>
                    <div class="pc-info-grid-modal">
                        <div class="pc-info-item">
                            <span class="pc-info-item-label">เลขบัตรประชาชน</span>
                            <span class="pc-info-item-value" id="modalCustIdCard">1-5099-00123-45-6</span>
                        </div>
                        <div class="pc-info-item">
                            <span class="pc-info-item-label">เลขที่สัญญา</span>
                            <span class="pc-info-item-value text-primary" id="modalCustContract">CT-6705-000123</span>
                        </div>
                        <div class="pc-info-item">
                            <span class="pc-info-item-label">เบอร์โทรศัพท์</span>
                            <span class="pc-info-item-value" id="modalCustPhone">081-234-5678</span>
                        </div>
                        <div class="pc-info-item">
                            <span class="pc-info-item-label">สาขา</span>
                            <span class="pc-info-item-value" id="modalCustBranch">ไมโครลิสซิ่ง สาขาเชียงใหม่</span>
                        </div>
                        <div class="pc-info-item">
                            <span class="pc-info-item-label">แผนผ่อนชำระ</span>
                            <span class="pc-info-item-value" id="modalCustPlan">6,000 / 12 เดือน</span>
                        </div>
                        <div class="pc-info-item col-span-2">
                            <span class="pc-info-item-label">ที่อยู่</span>
                            <span class="pc-info-item-value" id="modalCustAddress">99/123 หมู่ 4 ต.สุเทพ อ.เมือง จ.เชียงใหม่ 50200</span>
                        </div>
                    </div>
                </div>

                <!-- Record Form Section -->
                <div class="pc-modal-section-title">
                    <i class="bi bi-pencil-square text-primary"></i> ข้อมูลบันทึกผลการติดต่อ
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-medium">ครั้งที่ติดต่อ <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="modalContactCount">
                            <option value="1">ครั้งที่ 1</option>
                            <option value="2">ครั้งที่ 2</option>
                            <option value="3">ครั้งที่ 3</option>
                            <option value="4">ครั้งที่ 4</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-medium">ผลการติดต่อ <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="modalContactResult">
                            <option value="">-- เลือกผลการติดต่อ --</option>
                            <option value="สนใจ">สนใจ</option>
                            <option value="ไม่สนใจ">ไม่สนใจ</option>
                            <option value="ติดต่อไม่ได้">ติดต่อไม่ได้</option>
                            <option value="นัดติดตาม">นัดติดตาม</option>
                            <option value="รอนัดหมาย">รอนัดหมาย</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-medium">นัดหมายครั้งถัดไป</label>
                        <input type="date" class="form-control form-control-sm" id="modalNextDate">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-medium">หมายเหตุ</label>
                        <input type="text" class="form-control form-control-sm" id="modalRemarks" placeholder="ระบุหมายเหตุเพิ่มเติม (ถ้ามี)">
                    </div>
                </div>

                <!-- Contact History Section -->
                <div class="pc-modal-section-title">
                    <i class="bi bi-clock-history text-primary"></i> ประวัติการติดต่อล่าสุด
                </div>
                <div class="pc-modal-history-list">
                    <div class="pc-modal-history-item">
                        <div>
                            <div class="fw-semibold text-dark">นัดหมายติดตามเอกสารเพิ่มเติม</div>
                            <div class="text-muted small">15/05/2024 10:22 &bull; ครั้งที่ 1 &bull; โดย พงศกร คนสอน</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary">นัดติดตาม</span>
                    </div>
                    <div class="pc-modal-history-item">
                        <div>
                            <div class="fw-semibold text-dark">ติดต่อได้ ไม่สะดวกรับสาย</div>
                            <div class="text-muted small">14/05/2024 16:30 &bull; ครั้งที่ 1 &bull; โดย จิราภรณ์ วงษ์ดี</div>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary">ไม่สะดวก</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 px-4 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary px-4 rounded-pill fw-medium" id="btnSaveResult">
                    <i class="bi bi-check2-circle me-1"></i>บันทึกผลการติดต่อ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/prospectCall.js" asp-append-version="true"></script>
}
