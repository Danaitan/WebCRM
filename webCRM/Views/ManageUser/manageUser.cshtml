@{
    ViewData["Title"] = "ตั้งค่าสิทธิ์ผู้ใช้งาน";
    ViewData["HeaderTitle"] = "ตั้งค่าสิทธิ์ผู้ใช้งาน";
    ViewData["HeaderSubtitle"] = "จัดการสิทธิ์การเข้าถึงข้อมูล บทบาทหน้าที่ และการกำหนดสิทธิ์หน้าจอในระบบ";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/manageUse.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-3">
    <!-- Stat Cards Overview -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card card-stat shadow-sm bg-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small">ผู้ใช้งานทั้งหมดในระบบ</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1" id="statTotalUsers">0</h3>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card card-stat shadow-sm bg-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small">บทบาท/สิทธิ์การใช้งาน (Roles)</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1" id="statTotalRoles">0</h3>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card card-stat shadow-sm bg-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-medium small">เมนูและหน้าจอในระบบ</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1" id="statTotalPages">0</h3>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-layout-sidebar-inset"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <ul class="nav nav-pills nav-pills-custom gap-2" id="permissionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-users-link" data-bs-toggle="pill" data-bs-target="#tab-users" type="button" role="tab">
                        <i class="bi bi-person-gear me-2"></i>กำหนดสิทธิ์ผู้ใช้งาน (User Roles)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-role-pages-link" data-bs-toggle="pill" data-bs-target="#tab-role-pages" type="button" role="tab">
                        <i class="bi bi-shield-check me-2"></i>สิทธิ์เข้าถึงหน้าจอตามบทบาท (Role Permissions)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-roles-link" data-bs-toggle="pill" data-bs-target="#tab-roles" type="button" role="tab">
                        <i class="bi bi-sliders me-2"></i>จัดการบทบาทสิทธิ์ (Manage Roles)
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Tab Contents -->
    <div class="tab-content" id="permissionTabContent">
        <!-- TAB 1: User Roles Management -->
        <div class="tab-pane fade show active" id="tab-users" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-people text-primary me-2"></i>รายการผู้ใช้งานและการสิทธิ์ในระบบ
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="loadUsersData()">
                            <i class="bi bi-arrow-clockwise me-1"></i>รีเฟรชข้อมูล
                        </button>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Filter Toolbar -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" id="userSearchInput" class="form-control bg-light border-start-0" placeholder="ค้นหาตามรหัสพนักงาน หรือ ชื่อ-นามสกุล..." />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <select id="userRoleFilter" class="form-select bg-light">
                                <option value="">-- กรองตามบทบาทสิทธิ์ทั้งหมด --</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 text-sm-end">
                            <span class="text-muted small">แสดงผลทั้งหมด <span id="userCountBadge" class="fw-bold text-primary">0</span> รายการ</span>
                        </div>
                    </div>

                    <!-- User Table -->
                    <div class="table-responsive">
                        <table id="usersTable" class="table table-hover align-middle mb-0" style="width: 100%;">
                            <thead class="table-light">
                                <tr>
                                    <th>รหัสพนักงาน</th>
                                    <th>ชื่อ - นามสกุล</th>
                                    <th>แผนก / สาขา</th>
                                    <th>สิทธิ์ปัจจุบัน</th>
                                    <th style="width: 130px;" class="text-center">การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody">
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                        กำลังโหลดข้อมูลผู้ใช้งาน...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: Role Permissions Matrix -->
        <div class="tab-pane fade" id="tab-role-pages" role="tabpanel">
            <div class="row g-4">
                <!-- Role Selector Sidebar -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-shield-lock text-primary me-2"></i>เลือกบทบาทที่ต้องการตั้งค่า
                            </h6>
                        </div>
                        <div class="card-body p-3">
                            <div id="roleSelectionList" class="d-flex flex-column gap-2 overflow-auto" style="max-height: 520px;">
                                <div class="text-center text-muted py-3">กำลังโหลดรายการบทบาท...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Page Permissions Grid -->
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="bi bi-grid-1x2 text-primary me-2"></i>กำหนดสิทธิ์เข้าถึงหน้าจอสำหรับ: <span id="selectedRoleTitle" class="text-primary fw-bold">กรุณาเลือกบทบาท</span>
                                </h6>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" id="btnHeaderManageFuncs" disabled onclick="openSelectedRoleFuncModal()">
                                    <i class="bi bi-sliders me-1"></i>จัดการสิทธิ์ฟังก์ชัน
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSelectAllPages">
                                    <i class="bi bi-check-all me-1"></i>เลือกทั้งหมด
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDeselectAllPages">
                                    <i class="bi bi-x-circle me-1"></i>ล้างทั้งหมด
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div id="pagesListContainer" class="row g-3" style="max-height: 520px; overflow-y: auto;">
                                <div class="col-12 text-center text-muted py-5">
                                    <i class="bi bi-hand-index-thumb fs-2 d-block mb-2 text-secondary"></i>
                                    กรุณาคลิกเลือกบทบาทจากรายการด้านซ้าย เพื่อกำหนดสิทธิ์เข้าถึงหน้าจอ
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-light py-3 px-4 border-top d-flex justify-content-between align-items-center">
                            <span class="text-muted small">บันทึกสิทธิ์ของบทบาทที่เลือกในปัจจุบัน</span>
                            <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" id="btnSaveRolePages" disabled>
                                <i class="bi bi-save me-1"></i>บันทึกสิทธิ์การเข้าถึง
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: Manage Roles -->
        <div class="tab-pane fade" id="tab-roles" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-sliders text-primary me-2"></i>รายการบทบาททั้งหมดในระบบ (CRM Roles)
                        </h5>
                        <p class="text-muted small mb-0 mt-1">สามารถสร้างบทบาทใหม่เพื่อนำไปกำหนดสิทธิ์ผู้ใช้งานและหน้าจอได้</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addRoleModal">
                        <i class="bi bi-plus-lg me-1"></i>เพิ่มบทบาทใหม่
                    </button>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table id="rolesTable" class="table table-hover align-middle mb-0" style="width: 100%;">
                            <thead class="table-light">
                                <tr>
                                    <th>รหัสบทบาท (Role ID)</th>
                                    <th>ชื่อบทบาท (Role Name)</th>
                                    <th>ผู้สร้าง</th>
                                    <th>สถานะ</th>
                                </tr>
                            </thead>
                            <tbody id="rolesTableBody">
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">กำลังโหลดข้อมูลบทบาท...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Edit User Role -->
<div class="modal fade" id="editUserRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white bg-opacity-20 text-white p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-person-gear fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="editUserRoleModalLabel">
                            กำหนดบทบาทสิทธิ์ผู้ใช้งาน
                        </h5>
                        <span class="text-white-50 small">จัดการบทบาทสิทธิ์และสาขาที่รับผิดชอบสำหรับผู้ใช้งาน</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light bg-opacity-50">
                <form id="editUserRoleForm">
                    <div class="row g-4">
                        <!-- ฝั่งซ้าย: ข้อมูลผู้ใช้งาน และ การเลือกบทบาทสิทธิ์ (Role) -->
                        <div class="col-lg-5 border-end pe-lg-4">
                            <!-- User Card -->
                            <div class="card border border-light-subtle shadow-sm rounded-3 mb-4 bg-white">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.5rem;">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                            <span class="badge bg-secondary-subtle text-secondary border small px-2 py-0 mb-1" id="modalPersonnelCode">-</span>
                                            <h6 class="fw-bold text-dark mb-0 text-truncate" id="modalPersonnelName">-</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Role Dropdown Section -->
                            <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-3">
                                <div class="mb-3">
                                    <label for="modalRoleSelect" class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                                        <i class="bi bi-shield-lock-fill text-primary"></i>เลือกบทบาทสิทธิ์ (Role)
                                    </label>
                                    <select class="form-select form-select-lg" id="modalRoleSelect">
                                        <option value="">-- ยังไม่กำหนดบทบาท / ไม่มีสิทธิ์ --</option>
                                    </select>
                                </div>
                                <div class="alert alert-info py-2 px-3 mb-0 small border-0 bg-info-subtle text-info-emphasis rounded-3">
                                    <i class="bi bi-info-circle-fill me-1"></i>ผู้ใช้งาน 1 คนสามารถมีได้เพียง 1 บทบาท และจะได้รับสิทธิ์ตามที่กำหนดในบทบาทนั้น
                                </div>
                            </div>
                        </div>

                        <!-- ฝั่งขวา: สาขาที่รับผิดชอบ (Branches) -->
                        <div class="col-lg-7 ps-lg-4">
                            <div class="card border border-light-subtle shadow-sm rounded-3 bg-white p-3 h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-buildings-fill text-primary fs-5"></i>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">สาขาที่รับผิดชอบ</h6>
                                            <span class="text-muted small">คลิกเพื่อเลือกหรือยกเลิกสาขา</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6 fw-semibold" id="branchSelectedCount">
                                        เลือก 0 สาขา
                                    </span>
                                </div>

                                <div class="row g-2 align-items-center mb-3">
                                    <div class="col-sm-7">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                            <input type="text" class="form-control bg-light border-start-0 ps-0" id="branchSearchInput" placeholder="ค้นหารหัสหรือชื่อสาขา...">
                                        </div>
                                    </div>
                                    <div class="col-sm-5 text-sm-end d-flex justify-content-sm-end gap-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="btnSelectAllBranches">
                                            <i class="bi bi-check-all me-1"></i>เลือกทั้งหมด
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" id="btnDeselectAllBranches">
                                            <i class="bi bi-x-circle me-1"></i>ยกเลิกทั้งหมด
                                        </button>
                                    </div>
                                </div>

                                <div class="border rounded-3 p-3 bg-light overflow-auto flex-grow-1" id="modalBranchCheckboxContainer" style="max-height: 380px; min-height: 300px;">
                                    <div class="text-center text-muted py-4 small">กำลังโหลดรายการสาขา...</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-white border-top py-3 px-4 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x me-1"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSaveUserRole">
                    <i class="bi bi-save me-1"></i>บันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Add New Role -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-plus me-2"></i>เพิ่มบทบาทใหม่ในระบบ
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addRoleForm">
                    <div class="mb-3">
                        <label for="newRoleNameInput" class="form-label fw-bold text-dark">ชื่อบทบาท (Role Name) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg" id="newRoleNameInput" placeholder="เช่น Admin, Sale Manager, Tele-Sales" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top py-2 px-3">
                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-success rounded-pill px-4" id="btnCreateRole">
                    <i class="bi bi-plus-circle me-1"></i>สร้างบทบาท
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Manage Role Functions -->
<div class="modal fade" id="manageRoleFuncModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-sliders me-2"></i>จัดการสิทธิ์ฟังก์ชันการทำงาน (Role Functions)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Role Info Header Banner -->
                <div class="bg-light p-3 rounded-3 mb-3 border d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="bi bi-shield-lock-fill fs-5"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">บทบาทที่กำลังตั้งค่า:</span>
                            <span class="fw-bold text-dark fs-6" id="modalFuncRoleName">-</span>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 small fw-semibold">
                            Role ID: <span id="modalFuncRoleId">-</span>
                        </span>
                    </div>
                </div>

                <!-- Search and Quick Actions Bar -->
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-12 col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="funcSearchInput" class="form-control bg-light border-start-0" placeholder="ค้นหาฟังก์ชันตามรหัส หรือ ชื่อ..." />
                        </div>
                    </div>
                    <div class="col-12 col-md-6 text-md-end d-flex justify-content-md-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectAllFuncs">
                            <i class="bi bi-check-all me-1"></i>เลือกทั้งหมด
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDeselectAllFuncs">
                            <i class="bi bi-x-circle me-1"></i>ล้างทั้งหมด
                        </button>
                    </div>
                </div>

                <!-- Functions List Container -->
                <div id="modalFuncListContainer" class="row g-3 overflow-auto" style="max-height: 400px;">
                    <div class="col-12 text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        กำลังโหลดข้อมูลฟังก์ชัน...
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top py-2 px-3 d-flex justify-content-between">
                <span class="text-muted small" id="funcCountSummary">รายการฟังก์ชัน</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSaveRoleFuncs">
                        <i class="bi bi-save me-1"></i>บันทึกสิทธิ์ฟังก์ชัน
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

