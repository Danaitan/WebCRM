@{
    ViewData["Title"] = "ขายและติดตาม";
    ViewData["HeaderTitle"] = "รายละเอียด ขายและติดตาม";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productApprove.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prospectCall.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
}

<div class="pa-layout">
    <!-- Left Sidebar -->
    <div class="pa-sidebar-left">
        <div class="pa-sidebar-header">
            <h5>รายการขายและติดตาม</h5>
            <div class="badge-count" id="campaignCount">0</div>
        </div>

        <div class="pa-search-box">
            <div class="pa-search-input-group">
                <i class="bi bi-search"></i>
                <input type="text" id="campaignSearch" placeholder="ค้นหาแคมเปญ / รหัสแคมเปญ">
            </div>
        </div>

        <div class="campaign-list-container flex-grow-1 overflow-auto">
            <div class="pa-campaign-list" id="campaignList">

            </div>
        </div>
        
        <!-- Campaign Pagination UI -->
        <div class="pa-table-pagination border-top pt-2 mt-auto d-flex justify-content-between align-items-center" id="campaignPaginationContainer" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">
            <span id="campaignPaginationText" class="text-muted">แสดง 0 จาก 0 รายการ</span>
            <div class="pa-page-controls" id="campaignPageControls"></div>
        </div>
    </div>

    <!-- Right Container -->
    <div class="pa-right-container">
        <!-- Content Wrapper (Main Area + Right Sidebar) -->
        <div class="pa-content-wrapper">

            <!-- Main Area -->
            <div class="pa-main-area">
                <!-- Top Section: Campaign Detail Header -->
                <div class="pa-section flex-shrink-0">
                    <div class="pa-section-title mb-3">
                        <i class="bi bi-megaphone"></i> รายละเอียด Campaign
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-4 col-xl-2 pa-form-group mb-0">
                            <label>รหัส Campaign</label>
                            <input type="text" id="detailId" class="pa-form-control" value="" readonly>
                        </div>
                        <div class="col-12 col-md-8 col-xl-4 pa-form-group mb-0">
                            <label>ชื่อ Campaign</label>
                            <input type="text" id="detailName" class="pa-form-control" value="โปรโมชัน ดอกเบี้ยพิเศษ 2.99%" readonly>
                        </div>
                        <div class="col-12 col-md-6 col-xl-2 pa-form-group mb-0">
                            <label>วันที่เริ่มต้น</label>
                            <div class="pa-form-control-icon">
                                <input type="text" id="detailStart" class="pa-form-control" value="01/05/2024" readonly>
                                <i class="bi bi-calendar"></i>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-2 pa-form-group mb-0">
                            <label>วันที่สิ้นสุด</label>
                            <div class="pa-form-control-icon">
                                <input type="text" id="detailEnd" class="pa-form-control" value="31/07/2024" readonly>
                                <i class="bi bi-calendar"></i>
                            </div>
                        </div>
                        <div class="col-12 col-md-12 col-xl-2 pa-form-group mb-0">
                            <label>วัตถุประสงค์</label>
                            <input type="text" id="detailObjective" class="pa-form-control" value="ส่งเสริมการขายสินเชื่อ" readonly>
                        </div>
                    </div>

                    <div class="col-12 mt-4" id="selectedFileNameDisplay">
                        <div class="d-flex align-items-center gap-2 flex-wrap">

                        </div>
                    </div>

                </div>

                <!-- Bottom Section: Customer Table (Full Height) -->
                <div class="pc-prospect-section">
                    <div class="pa-prospect-header">
                        <div class="pa-section-title mb-0">
                            <i class="bi bi-people"></i> รายละเอียด Prospect / ลูกค้า
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 ms-2" id="prospectCallTotalBadge">ทั้งหมด 0 รายการ</span>
                        </div>
                        <div class="pa-table-controls" style="flex-grow: 1; max-width: 340px;">
                            <div class="pa-search-input-group" style="width: 100%;">
                                <i class="bi bi-search"></i>
                                <input type="text" id="prospectSearch" placeholder="ค้นหา ชื่อ-นามสกุล, เลขที่สัญญา, เบอร์โทร">
                            </div>
                        </div>
                    </div>

                    <!-- Table Wrapper (Scrollable Full Height) -->
                    <div class="pc-table-wrapper">
                        <table class="pc-prospect-table" id="prospectTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px; text-align: center;">ลำดับ</th>
                                    <th>สาขา</th>
                                    <th>ชื่อ-นามสกุล</th>
                                    <th>เลขที่สัญญา</th>
                                    <th>เบอร์โทร</th>
                                    <th>สถานที่ใช้รถ</th>
                                    <th>ผลการติดต่อ</th>
                                    <th>วันที่ Assign</th>
                                    <th>Status Lead</th>
                                </tr>
                            </thead>
                            <tbody id="prospectTableBody">
                                <!-- Loaded dynamically from JS array -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="pa-table-pagination mt-2">
                        <span id="prospectPaginationText">แสดง 1 - 8 จาก 8 รายการ</span>
                        <div class="d-flex align-items-center gap-3">
                            <div class="pa-page-controls">
                                <button class="pa-page-btn"><i class="bi bi-chevron-left"></i></button>
                                <button class="pa-page-btn active">1</button>
                                <button class="pa-page-btn"><i class="bi bi-chevron-right"></i></button>
                            </div>
                            <select class="pa-form-control" style="width: auto; padding: 0.25rem 2rem 0.25rem 0.75rem;">
                                <option>10 / หน้า</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Record Result Pop-up Modal -->
<div class="modal fade pc-modal" id="recordResultModal" tabindex="-1" aria-labelledby="recordResultModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark fs-5" id="recordResultModalLabel">
                    บันทึกผลการติดต่อ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Customer Summary Info Card -->
                <div class="pc-summary-card mb-4 p-3 rounded-3 bg-white border">
                    <div class="row g-3 align-items-center">
                        <!-- Row 1 -->
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-person fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">ชื่อลูกค้า</div>
                                    <div class="fw-bold text-dark fs-6" id="modalCustName">น.ส. อมรรัตน์ ใจดี</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-success bg-success-subtle"><i class="bi bi-telephone-fill fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">เบอร์โทรศัพท์</div>
                                    <div class="d-flex align-items-center gap-2 mt-0.5">
                                        <span class="fw-bold text-dark fs-6" id="modalCustPhone"></span>
                                        <button type="button" class="btn btn-success btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5 pc-btn-call" id="btnModalCall">
                                            <i class="bi bi-telephone-outbound-fill"></i> <span>โทรออก</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-megaphone fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">แคมเปญ</div>
                                    <div class="fw-bold text-dark fs-6" id="modalCustCampaign">CMP-2024-0001</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-megaphone fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">ชื่อแคมเปญ</div>
                                    <div class="fw-bold text-dark fs-6" id="modalCustCampaignName">โปรโมชัน ดอกเบี้ยพิเศษ 2.99%</div>
                                </div>
                            </div>
                        </div>

                        <!-- Row 2 -->
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-person-badge fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">วัตถุประสงค์</div>
                                    <div><span class="pc-modal-obj-badge green" id="modalCustObjective"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-info-circle fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">Status Lead ปัจจุบัน</div>
                                    <div><span class="status-badge badge bg-primary text-white" id="modalCustLeadStatus">Follow</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-journal-text fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">ผลการติดต่อล่าสุด</div>
                                    <div><span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill fw-semibold" id="modalCustLastResult">ขอข้อมูลเพิ่มเติม</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="pc-summary-icon text-primary"><i class="bi bi-calendar-event fs-5"></i></div>
                                <div>
                                    <div class="text-muted extra-small">นัดหมายครั้งถัดไป</div>
                                    <div class="fw-bold text-dark fs-6" id="modalCustNextAppt">20/05/2024 14:00</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Left Column: Form -->
                    <div class="col-lg-8 d-flex flex-column">
                        <div class="row g-3 flex-grow-1 d-flex flex-column">

                            <div class="col-12">
                                <div class="row g-3">
                                    <div class="col-md-4">

                                    <div class="md-3">
                                        <label class="form-label text-dark small fw-medium mb-1">ผลิตภัณฑ์ที่เสนอ</label>
                                        <select class="form-select form-select-sm" id="modalProduct">
                                            <option value="" disabled selected>เลือกผลิตภัณฑ์</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-dark small fw-medium mb-1">ผลการติดต่อ <span class="text-danger">*</span></label>
                                        <select class="form-select form-select-sm" id="modalContactResult">
                                            <option value="" disabled selected>เลือกผลการติดต่อ</option>
                                        </select>
                                    </div>

                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label text-dark small fw-medium mb-1">รายงานผลการติดต่อ <span class="text-danger">*</span></label>
                                        <div class="position-relative">
                                            <textarea class="form-control form-control-sm" id="modalContactReport" rows="4" maxlength="500" placeholder="ระบุรายละเอียดการติดต่อ เช่น ลูกค้าสนใจ / ไม่สนใจ / ขอข้อมูลเพิ่มเติม / สาเหตุ ฯลฯ"></textarea>
                                            <span class="position-absolute bottom-0 end-0 p-2 text-muted extra-small" id="contactReportCount" style="pointer-events: none; z-index: 5;">0/500</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">Status Lead <span class="text-danger">*</span></label>
                                        <select class="form-select form-select-sm" id="modalStatusLead">
                                            <option value="" disabled selected>เลือก Status Lead</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">รายงานผล</label>
                                        <select class="form-select form-select-sm" id="modalSalesResult">
                                            <option value="" disabled selected>เลือกผลการรายงานผล</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">ระดับคะแนน</label>
                                        <select class="form-select form-select-sm" id="modalInterestLevel">
                                            <option value="" disabled selected>เลือกระดับความสนใจ</option>
                                        </select>
                                    </div>

                                </div>
                            </div>

                            <div class="col-12">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">นัดหมายครั้งถัดไป</label>
                                        <input type="date" class="form-control form-control-sm" id="modalNextDate">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">เวลานัดหมาย (ถ้ามี)</label>
                                        <input type="time" class="form-control form-control-sm" id="modalNextTime">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-dark small fw-medium mb-1">ช่องทางการนัดหมาย</label>
                                        <select class="form-select form-select-sm" id="modalContactChannel">
                                            <option value="" disabled selected>เลือกช่องทาง</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 flex-grow-1 d-flex flex-column">
                                <label class="form-label text-dark small fw-medium mb-1">หมายเหตุเพิ่มเติม</label>
                                <div class="position-relative flex-grow-1 d-flex flex-column">
                                    <textarea class="form-control form-control-sm flex-grow-1" id="modalRemarks" style="min-height: 80px;" maxlength="300" placeholder="ระบุหมายเหตุเพิ่มเติม (ถ้ามี)"></textarea>
                                    <span class="position-absolute bottom-0 end-0 p-2 text-muted extra-small" id="remarksCount" style="pointer-events: none; z-index: 5;">0/300</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Contact History Sidebar -->
                    <div class="col-lg-4 d-flex flex-column h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-shrink-0">
                            <h6 class="fw-bold text-dark mb-0 small">ประวัติการติดต่อ <span class="fw-normal text-muted" id="modalHistoryCount">(ล่าสุด 0 รายการ)</span></h6>
                        </div>
                        <div class="pc-modal-history-list d-flex flex-column gap-2 flex-grow-1" id="modalHistoryList" style="max-height: 420px; overflow-y: auto; overflow-x: hidden;">
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer bg-white border-top-0 px-4 py-3 justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-3 fw-medium" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary px-4 rounded-3 fw-medium" id="btnSaveResult">
                    <i class="bi bi-floppy me-1"></i>บันทึกผลการติดต่อ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CURRENT_USER_ID = '@(Context.Session.GetString("personalId") ?? "")';
    </script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/prospectCall.js" asp-append-version="true"></script>
}
