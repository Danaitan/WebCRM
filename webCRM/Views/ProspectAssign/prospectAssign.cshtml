@{
    ViewData["Title"] = "Prospect Assign";
    ViewData["HeaderTitle"] = "Prospect Assign";
    ViewData["HeaderSubtitle"] = "กำหนดผู้รับผิดชอบลูกค้า Propect ตาม Campaign";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospectAssign.css" asp-append-version="true" />
}
<div class="container-fluid p-4 h-100 d-flex flex-column" style"gap: 20px;">
    
    <!-- Top Section -->
    <div class="row g-4">
        
        <!-- Left Side: Filter + Summary -->
        <div class="col-xl-8 col-lg-7 d-flex flex-column" style="gap: 20px;">
            
            <!-- Filter Card -->
            <div class="card-custom p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label-custom">Campaign Code</label>
                        <input type="text" id="filterCampaignCode" class="form-control form-control-custom" placeholder="เช่น CAM-202505">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom">Campaign Name</label>
                        <input type="text" id="filterCampaignName" class="form-control form-control-custom" placeholder="เช่น สินเชื่อรถยนต์ พ.ศ. 2568">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom">วันที่เริ่มต้น</label>
                        <div class="position-relative">
                            <i class="bi bi-calendar position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-gray);"></i>
                            <input type="text" id="filterStartDate" class="form-control form-control-custom" value="" style="padding-left: 35px;">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom">วันที่สิ้นสุด</label>
                        <div class="position-relative">
                            <i class="bi bi-calendar position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-gray);"></i>
                            <input type="text" id="filterEndDate" class="form-control form-control-custom" value="" style="padding-left: 35px;">
                        </div>
                    </div>
                    
                    <div class="col-md-5">
                        <label class="form-label-custom">หมายเหตุ</label>
                        <input type="text" id="filterRemark" class="form-control form-control-custom" placeholder="ระบุหมายเหตุ (ถ้ามี)">
                    </div>
                    <div class="col-md-7">
                        <label class="form-label-custom">เลือกสาขา / Branch (เลือกได้หลายสาขา)</label>
                        <div class="form-control form-control-custom d-flex align-items-center flex-wrap gap-2 py-1" style="min-height: 38px; height: auto;">
                            <span class="branch-tag">00 สำนักงานใหญ่ <i class="bi bi-x"></i></span>
                            <div class="d-flex align-items-center flex-grow-1 ms-1">
                                <i class="bi bi-search" style="font-size: 0.8rem; color: #94a3b8;"></i>
                                <input type="text" class="border-0 shadow-none bg-transparent" placeholder="ค้นหาสาขา" style="outline: none; font-size: 0.85rem; width: 80px; margin-left: 5px;">
                            </div>
                            <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem; color: #94a3b8;"></i>
                        </div>
                    </div>

                    <div class="col-12" id="importExcelContainer">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div id="selectedFileNameDisplay" class="d-flex align-items-center gap-2 px-3 py-1 bg-light border rounded" style="font-size: 0.875rem;">
                                <i class="bi bi-file-earmark-text text-primary fs-5"></i>
                                <span class="fw-medium text-dark"> ตัวอย่างไฟล์แนบ.xlsx </span>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
            
            <!-- Summary Cards -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="summary-card active" data-status="all">
                        <div class="summary-icon blue"><i class="bi bi-people"></i></div>
                        <div class="summary-info">
                            <span class="summary-title">Prospect ทั้งหมด</span>
                            <span class="summary-value">0</span>
                            <span class="summary-unit">รายการ</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card" data-status="assign">
                        <div class="summary-icon green"><i class="bi bi-person-check"></i></div>
                        <div class="summary-info">
                            <span class="summary-title">Assign</span>
                            <span class="summary-value">0</span>
                            <span class="summary-unit">รายการ</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card" data-status="reassign">
                        <div class="summary-icon orange"><i class="bi bi-arrow-repeat"></i></div>
                        <div class="summary-info">
                            <span class="summary-title">ReAssign</span>
                            <span class="summary-value">0</span>
                            <span class="summary-unit">รายการ</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="summary-card" data-status="wait">
                        <div class="summary-icon purple"><i class="bi bi-clock-history"></i></div>
                        <div class="summary-info">
                            <span class="summary-title">Wait</span>
                            <span class="summary-value">0</span>
                            <span class="summary-unit">รายการ</span>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
        
        <!-- Right Side: Assign Panel -->
        <div class="col-xl-4 col-lg-5">
            <div class="card-custom p-4 h-100">
                
                <div class="d-flex gap-3 mb-4">
                    <div class="assign-method-btn">
                        <i class="bi bi-robot"></i>
                        <span>Auto<br>Assign</span>
                    </div>
                </div>
                
                <div class="mb-4 position-relative" id="responsibleSelectContainer">
                    <label class="form-label-custom">เลือกผู้รับผิดชอบ</label>
                    <div class="form-control form-control-custom d-flex align-items-center flex-wrap gap-2 py-1 bg-light border-0" style="min-height: 38px; height: auto; cursor: pointer;" id="responsibleSelectBox">
                        <!-- Selected items will be appended here -->
                        <div class="d-flex align-items-center flex-grow-1 ms-1">
                            <input type="text" class="border-0 shadow-none bg-transparent" placeholder="ค้นหาพนักงาน" style="outline: none; font-size: 0.85rem; width: 100px;">
                        </div>
                        <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem; color: #94a3b8;"></i>
                    </div>
                    
                    <!-- Dropdown Menu -->
                    <div class="dropdown-menu w-100 shadow-sm border mt-1 p-2" id="responsibleDropdownMenu" style="display: none; position: absolute; z-index: 1000; max-height: 200px; overflow-y: auto; background: white; border-radius: 8px;">
                        <div class="dropdown-item d-flex align-items-center gap-2 py-2 responsible-option rounded" style="cursor: pointer;" data-value="A">
                            <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                            <span>A</span>
                        </div>
                        <div class="dropdown-item d-flex align-items-center gap-2 py-2 responsible-option rounded" style="cursor: pointer;" data-value="B">
                            <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                            <span>B</span>
                        </div>
                        <div class="dropdown-item d-flex align-items-center gap-2 py-2 responsible-option rounded" style="cursor: pointer;" data-value="C">
                            <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                            <span>C</span>
                        </div>
                    </div>
                </div>
                
                <div class="selected-count-box mb-4">
                    <i class="bi bi-people text-primary fs-5"></i>
                    <span class="fw-medium text-primary" id="selectedProspectCount">Selected: 0 รายการ</span>
                </div>
                
                <button id="assignBtn" class="btn-primary-custom w-100 d-flex align-items-center justify-content-center gap-2 py-3 mt-auto" style="font-size: 1rem;">
                    Assign
                </button>
                
            </div>
        </div>
        
    </div>
    
    <!-- Bottom Section -->
    <div class="row g-4 flex-grow-1" style="min-height: 400px;">
        
        <!-- Left: Batch List -->
        <div class="col-xl-3 col-lg-4 d-flex flex-column h-100">
            <div class="card-custom d-flex flex-column h-100">
                
                <div class="p-3 border-bottom">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-gray);"></i>
                        <input type="text" id="batchSearchInput" class="form-control form-control-custom bg-light border-0" placeholder="ค้นหา" style="padding-left: 35px;">
                    </div>
                </div>
                
                <div class="flex-grow-1 overflow-auto" id="batchListContainer">
                    <!-- Batch items rendered dynamically -->
                </div>
                
                <div class="p-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.8rem;">
                    <span id="batchPageInfo">0 - 0 จาก 0</span>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-chevron-double-left" id="batchFirstBtn" style="cursor:pointer;" title="หน้าแรก"></i>
                        <i class="bi bi-chevron-left" id="batchPrevBtn" style="cursor:pointer;" title="หน้าก่อน"></i>
                        <div id="batchPageNumbers" class="d-flex align-items-center gap-1 mx-1"></div>
                        <i class="bi bi-chevron-right" id="batchNextBtn" style="cursor:pointer;" title="หน้าถัดไป"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right: Table -->
        <div class="col-xl-9 col-lg-8 d-flex flex-column h-100">
            <div class="card-custom d-flex flex-column h-100">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-medium text-dark" style="font-size: 1rem;">Prospect ที่พร้อม Assign</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 ms-2" id="prospectAssignTotalBadge">ทั้งหมด 0 รายการ</span>
                    </div>
                </div>
                
                <div class="flex-grow-1 overflow-auto">
                    <table class="table table-custom mb-0" id="prospectAssignTable">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;">
                                    <input type="checkbox" class="form-check-input mt-0 border-primary" id="selectAllProspects">
                                </th>
                                <th>สาขา</th>
                                <th>ชื่อ-นามสกุล / เลขบัตรประชาชน</th>
                                <th>เลขที่สัญญา</th>
                                <th>ประเภทลูกค้า</th>
                                <th>อาชีพ</th>
                                <th>สถานที่ใช้รถ</th>
                                <th>ผู้รับผิดชอบ</th>
                                <th>สถานะ</th>
                            </tr>
                        </thead>
                        <tbody id="prospectAssignTableBody">
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-hourglass-split me-1"></i> กำลังโหลดข้อมูล Prospect...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <div class="p-3 border-top d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2 text-gray" style="font-size: 0.85rem;">
                        <span>แสดง</span>
                        <select id="rowsPerPageSelect" class="form-select form-select-sm border-0 bg-light" style="width: 60px;">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <span>รายการ / ทั้งหมด <span id="totalRowsInfo">0</span> รายการ</span>
                    </div>
                    
                    <ul class="pagination pagination-sm pagination-custom mb-0 d-flex align-items-center gap-1" id="prospectPagination">
                    </ul>
                </div>
            </div>
        </div>
        
    </div>

    <!-- ReAssign Modal -->
    <div class="modal fade" id="reAssignModal" tabindex="-1" aria-labelledby="reAssignModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <div class="modal-header border-bottom-0 pb-0 mt-2">
                    <h5 class="modal-title fw-bold" id="reAssignModalLabel" style="font-size: 1.1rem; color: #1e293b;">ระบุเหตุผลการ Re-Assign</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pb-0">
                    <div class="mb-3 position-relative" id="newResponsibleSelectContainer">
                        <label class="form-label-custom">เลือกผู้รับผิดชอบใหม่</label>
                        <div class="form-control form-control-custom d-flex align-items-center flex-wrap gap-2 py-1 bg-light border-0" style="min-height: 38px; height: auto; cursor: pointer;" id="newResponsibleSelectBox">
                            <div class="d-flex align-items-center flex-grow-1 ms-1">
                                <input type="text" class="border-0 shadow-none bg-transparent" placeholder="ค้นหาพนักงาน" style="outline: none; font-size: 0.85rem; width: 100px;">
                            </div>
                            <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem; color: #94a3b8;"></i>
                        </div>
                        
                        <!-- Dropdown Menu -->
                        <div class="dropdown-menu w-100 shadow-sm border mt-1 p-2" id="newResponsibleDropdownMenu" style="display: none; position: absolute; z-index: 1000; max-height: 200px; overflow-y: auto; background: white; border-radius: 8px;">
                            <div class="dropdown-item d-flex align-items-center gap-2 py-2 new-responsible-option rounded" style="cursor: pointer;" data-value="A">
                                <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                                <span>A</span>
                            </div>
                            <div class="dropdown-item d-flex align-items-center gap-2 py-2 new-responsible-option rounded" style="cursor: pointer;" data-value="B">
                                <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                                <span>B</span>
                            </div>
                            <div class="dropdown-item d-flex align-items-center gap-2 py-2 new-responsible-option rounded" style="cursor: pointer;" data-value="C">
                                <input type="checkbox" class="form-check-input mt-0 border-primary" style="pointer-events: none;">
                                <span>C</span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-custom">เหตุผล</label>
                        <textarea class="form-control form-control-custom bg-light border-0" rows="3" placeholder="ระบุเหตุผลที่ต้องการเปลี่ยนผู้รับผิดชอบ..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-3 mt-2">
                    <button type="button" class="btn btn-outline-custom bg-transparent border text-dark" data-bs-dismiss="modal" style="border-radius: 8px;">ยกเลิก</button>
                    <button type="button" class="btn-primary-custom" style="border-radius: 8px; padding: 6px 24px;">ยืนยัน</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/prospectAssign.js" asp-append-version="true"></script>
}
