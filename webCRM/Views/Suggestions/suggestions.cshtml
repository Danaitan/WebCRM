@model List<webCRM.Models.ResponseSuggestion>
@{
    ViewData["Title"] = "ข้อเสนอแนะ / ร้องเรียน";
    ViewData["HeaderTitle"] = "ข้อเสนอแนะ / ร้องเรียน";
    ViewData["HeaderSubtitle"] = "บันทึกและติดตามข้อเสนอแนะ ข้อร้องเรียน หรือความสนใจผลิตภัณฑ์จากลูกค้า";
}

@section Styles {
    <link rel="stylesheet" href="~/css/suggestions.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
}

    <div class="container-fluid p-4 crm-main">
                <!-- Search Card -->
                <div class="bg-white rounded-4 p-4 shadow-sm mb-4 border border-light">
                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold text-dark-blue mb-2">ค้นหาข้อเสนอแนะ</h6>
                            <div class="d-flex flex-column flex-md-row gap-3">
                                <select id="filterTopic" class="form-select rounded-3 text-muted" style="width: auto; min-width: 160px;">
                                    <option value="">หัวข้อ (ทั้งหมด)</option>
                                </select>
                                <select id="filterStatus" class="form-select rounded-3 text-muted" style="width: auto; min-width: 140px;">
                                    <option value="">สถานะ (ทั้งหมด)</option>
                                </select>
                                <div class="position-relative flex-grow-1">
                                    <input type="text" id="customSearchInput" class="form-control rounded-3 py-2 ps-3 pe-5" placeholder="ค้นหาโดย หัวข้อ / ชื่อ-นามสกุล / สถานะ" />
                                    <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                                </div>
                                <div>
                                    <button type="button" id="btnSearch" class="btn btn-primary px-4 py-2 fw-medium d-flex align-items-center gap-2 rounded-3 shadow-sm" onclick="searchSuggestion()">
                                        <i class="bi bi-search"></i>
                                        <span>ค้นหา</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

        <div class="row g-4">
            <!-- Left Column: Table -->
            <div class="col-12 col-xl-8">

                <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-list-ul text-primary fs-5"></i>
                            <h6 class="fw-bold text-dark-blue mb-0">รายการข้อเสนอแนะ / ร้องเรียน</h6>
                            <span class="bg-primary-subtle text-primary rounded-pill px-3 py-1 ms-2 fs-7" id="suggestionsTotalBadge">ทั้งหมด 0 รายการ</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button 
                                type="button" 
                                class="btn btn-primary px-4 py-2 fw-medium d-flex align-items-center gap-2 rounded-3 shadow-sm" 
                                data-bs-toggle="modal" 
                                data-bs-target="#complaintModal"
                            >
                                <i class="bi bi-plus-circle fs-5"></i>
                                <span>เพิ่มข้อเสนอแนะ / ร้องเรียน</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table id="suggestionsTable" class="table table-hover table-borderless align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-semibold text-muted py-3 text-center rounded-start" style="white-space: nowrap;">วันที่สร้าง</th>
                                    <th class="fw-semibold text-muted py-3 text-center" style="white-space: nowrap;">หัวข้อ</th>
                                    <th class="fw-semibold text-muted py-3 text-center" style="white-space: nowrap;">ชื่อ-นามสกุล</th>
                                    <th class="fw-semibold text-muted py-3 text-center" style="white-space: nowrap;">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <span>สถานะ</span>

                                            <button 
                                                type="button" 
                                                class="btn btn-outline-secondary border-0 rounded-circle d-flex align-items-center justify-content-center p-0 shadow-sm" 
                                                style="width: 38px; height: 38px; background-color: #f1f5f9; color: #475569;" 
                                                id="statusInfoPopover"
                                                tabindex="0"
                                                data-bs-toggle="popover" 
                                                data-bs-placement="bottom" 
                                                data-bs-trigger="click"
                                                data-bs-html="true" 
                                                data-bs-title="<span class='fw-bold text-dark-blue'><i class='bi bi-info-circle me-1'></i> คำอธิบายสถานะ</span>" 
                                                data-bs-content="
                                                <div 
                                                class='py-1' 
                                                style='font-size: 0.875rem; 
                                                line-height: 1.8;'
                                                >
                                                    <div>
                                                    <strong>pending</strong>
                                                    - รอการติดต่อ
                                                    </div>
                                                    <div>
                                                    <strong>forward</strong> 
                                                    - ส่งต่อ
                                                    </div>
                                                    <div>
                                                    <strong>reply</strong>
                                                    - ตอบกลับ
                                                    </div>
                                                    <div>
                                                    <strong>close</strong>
                                                    - ปิดงาน
                                                    </div>
                                                </div>"
                                            >
                                                <i class="bi bi-info-circle fs-5"></i>
                                            </button>

                                        </div>
                                    </th>
                                    <th class="fw-semibold text-muted py-3 text-center" style="white-space: nowrap;">อัพเดทล่าสุด</th>
                                    <th class="fw-semibold text-muted py-3 text-center rounded-end" style="white-space: nowrap;">จำนวนวัน</th>
                                </tr>
                            </thead>
                            <tbody id="suggestionResultBody">
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                         DateTime? displayCreatedDate = (item.CreatedDate.HasValue && item.CreatedDate.Value.Year > 1900) ? item.CreatedDate : null;
                                         if (!displayCreatedDate.HasValue && item.DateSugges.HasValue && item.DateSugges.Value.Year > 1900)
                                         {
                                             displayCreatedDate = item.TimeSugges.HasValue && item.TimeSugges.Value.Year > 1900
                                                 ? item.DateSugges.Value.Date.Add(item.TimeSugges.Value.TimeOfDay) 
                                                 : item.DateSugges.Value;
                                         }
                                         if (!displayCreatedDate.HasValue && item.UpDate.HasValue && item.UpDate.Value.Year > 1900)
                                         {
                                             displayCreatedDate = item.UpDate;
                                         }
                                         var createdDateStr = displayCreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "-";
                                         var createdDateOrder = displayCreatedDate?.ToString("yyyyMMddHHmmss") ?? "0";

                                         var upDateStr = item.UpDate is { Year: > 1900 } upDateVal ? upDateVal.ToString("dd/MM/yyyy HH:mm") : "-";
                                         var upDateOrder = item.UpDate is { Year: > 1900 } upDateValOrder ? upDateValOrder.ToString("yyyyMMddHHmmss") : "0";

                                         var timeDiffText = "-";
                                         var daysOrder = 999999;
                                         if (displayCreatedDate.HasValue && displayCreatedDate.Value.Year > 1900)
                                         {
                                             var days = (DateTime.Now.Date - displayCreatedDate.Value.Date).Days;
                                             daysOrder = days;
                                             timeDiffText = $"{days} วัน";
                                         }
                                        <tr style="cursor: pointer;" onclick="showDetails(this)"
                                            data-phone="@(item.PhoneProvider ?? "-")"
                                            data-contact="@(item.DateSugges?.ToString("dd/MM/yyyy") ?? "-") @(item.TimeSugges?.ToString("HH:mm") ?? "")"
                                            data-email="@(item.EmailProvider ?? "-")"
                                            data-line="@(item.LineProvider ?? "-")"
                                            data-idno="@(item.Idno ?? "-")"
                                            data-status="@(item.StatusTask?.ToLower() ?? "-")"
                                            data-address="@(item.AddressProvider ?? "-")"
                                            data-date="@createdDateStr"
                                            data-recordedby="@(item.PersonalName ?? "-")"
                                            data-reply="@(item.Reply ?? "-")"
                                            data-nameprovider="@(item.NameProvider ?? "-")"
                                            data-suggestion="@(item.Suggestion ?? "-")"
                                            data-guid="@(item.Guid ?? "-")"
                                            data-updby="@(item.UpdBy ?? "-")"
                                            data-sendto="@(item.SendTo ?? "-")"
                                            data-details='@(item.Detail != null ? System.Text.Json.JsonSerializer.Serialize(item.Detail) : "[]")'
                                            >
                                            <td class="text-center py-2" data-order="@createdDateOrder"><div class="fw-medium text-dark">@createdDateStr</div></td>
                                            <td class="text-center py-2"><div class="fw-medium text-dark">@(item.SuggestionTitle ?? "-")</div></td>
                                            <td class="text-center py-2"><div class="fw-medium text-dark">@(item.NameProvider ?? "-")</div></td>
                                            <td class="text-center py-2"><div class="fw-medium text-dark">@(item.StatusTask?.ToLower() ?? "-")</div></td>
                                            <td class="text-center py-2" data-order="@upDateOrder"><div class="fw-medium text-dark">@upDateStr</div></td>
                                            <td class="text-center py-2" data-order="@daysOrder"><div class="fw-medium text-dark">@timeDiffText</div></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    
                </div>
            </div>

            <!-- Right Column: Summary -->
            <div class="col-12 col-xl-4">
                <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100 d-flex flex-column">
                    <h6 class="fw-bold text-dark-blue mb-2">รายละเอียด</h6>

                    <hr class="text-muted opacity-25 mb-3">

                    <div class="d-flex flex-column gap-3 flex-grow-1">
                        <div class="row g-3 mb-3 border-bottom pb-4">
                        
                            <div class="col-12">
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">ชื่อ-นามสกุล</div>
                                    <div class="fw-semibold text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-nameprovider">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">เบอร์โทร</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-phone">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">วัน-เวลานัดหมาย</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-contact-back">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">E-mail</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-email">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">Line ID</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-line">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">เลขประจำตัวประชาชน</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-idno">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">สถานะเคส</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-status">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">ที่อยู่ในการติดต่อ</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-address">-</div>
                                </div>
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">วันสร้าง</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-date">-</div>
                                </div>

                                <div class="d-flex mb-3 align-items-start">
                                    <div class="text-muted fw-medium" style="min-width: 150px; flex-shrink: 0;">ข้อความเสนอแนะ</div>
                                    <div class="fw-medium text-dark" style="flex: 1; min-width: 0; word-break: break-word; overflow-wrap: break-word;" id="detail-suggestion">-</div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between mb-3 mt-4">
                                    <h6 style="text-decoration: underline; text-decoration-style: double;" class="text-dark-blue mb-0 fw-bold">
                                        ข้อมูลการตอบกลับ
                                    </h6>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1" id="replyHistoryTotalBadge">ทั้งหมด 0 รายการ</span>
                                </div>

                                <div class="table-responsive mb-3">
                                    <table class="table table-bordered align-middle mb-0" style="font-size: 0.875rem;" id="reply-history-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center text-muted fw-semibold py-2" style="width: 140px; white-space: nowrap;">วันที่ตอบกลับ</th>
                                                <th class="text-center text-muted fw-semibold py-2" style="width: 140px; white-space: nowrap;">บันทึกโดย</th>
                                                <th class="text-center text-muted fw-semibold py-2">ข้อความตอบกลับ</th>
                                            </tr>
                                        </thead>
                                        <tbody id="detail-reply-list">
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-3">ไม่มีข้อมูลการตอบกลับ</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <span id="detail-guid" class="d-none"></span>
                                <span id="detail-updBy" class="d-none"></span>
                                <span id="detail-sendTo" class="d-none"></span>
                            </div>

                            <div id="replyBoxSection">
                                <h6 style="text-decoration: underline; text-decoration-style: double;" class="mb-2 mt-2 fw-bold">
                                    บันทึกข้อมูล
                                </h6>
                                
                                <div class="col-12 mt-1">
                                    <div class="border p-3 bg-white" style="border-radius: 6px; border-color: #e2e8f0;">
                                        <div class="mb-2" style="font-size: 0.95rem; word-break: break-word; overflow-wrap: break-word;">
                                            <span class="fw-bold" style="color: #0f5132;">ข้อความตอบกลับ:</span>
                                        </div>
                                        <textarea id="reply-input" class="form-control mb-2" rows="3" style="resize: none; border-color: #e2e8f0;" placeholder="กรอกข้อความตอบกลับที่นี่..."></textarea>
                                        <div class="d-flex justify-content-between mb-3 text-dark-blue" style="font-size: 0.85rem; font-family: 'Courier New', Courier, monospace; font-weight: bold;">
                                            <span>@(Context.Session.GetString("fullNameEn") ?? "")</span>
                                            <span>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                        </div>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-primary px-4 fw-bold" id="saveReplyBtn" style="border-radius: 4px;">บันทึก</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <div id="forwardBtnContainer">
                                    <button 
                                    type="button" 
                                    class="btn btn-warning px-4 fw-bold" 
                                    id="forwardBtn" 
                                    style="border-radius: 4px;"
                                    >
                                    ส่งต่อ
                                    </button>
                                </div>

                                <div id="closeBtnContainer">
                                    <button 
                                    type="button" 
                                    class="btn btn-danger px-4 fw-bold" 
                                    id="closeBtn"
                                    style="border-radius: 4px;"
                                    >
                                    ปิดงาน
                                    </button>
                                </div>
                            </div>
                                
                        </div>
                    </div>

                </div>
            </div>
            
        </div>
    </div>

@section Scripts {
    <partial name="~/Views/Component/NotiModal.cshtml" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        var currentUserEmail = '@(Context.Session.GetString("email") ?? "")';
        var userCompany = '@(Context.Session.GetString("company") ?? "")';
        var userFullNameTh = '@(Context.Session.GetString("fullNameTh") ?? "")';
        window.CURRENT_COMPANY = '@(Context.Session.GetString("company") ?? "")';
    </script>
    <script src="~/js/suggestions.js" asp-append-version="true"></script>
}

    <!-- Complaint Modal -->
    <div class="modal fade" id="complaintModal" tabindex="-1" aria-labelledby="complaintModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5 pt-0">
                    <!-- Form Card -->
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-file-earmark-text text-primary fs-5"></i>
                        <h6 class="fw-bold text-dark-blue mb-0">รายละเอียดข้อเสนอแนะ / ร้องเรียน</h6>
                    </div>

                    <form>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-medium small">หัวข้อ <span class="text-danger">*</span></label>
                                <select class="form-select text-dark" aria-label="Topic" id="post-title">
                                    <option value="" selected class="text-muted">เลือกหัวข้อ</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-medium small">ชื่อ นามสกุล (ผู้ให้ข้อมูล) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="post-personal-name" placeholder="กรุณากรอกชื่อ-นามสกุล">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-medium small">E-Mail (ของผู้ให้ข้อมูล)</label>
                                <input type="email" class="form-control" id="post-personal-email" placeholder="ตัวอย่าง: example@email.com">
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-medium small">ที่อยู่ในการติดต่อ</label>
                                <textarea class="form-control" rows="4" id="post-address" placeholder="กรุณากรอกที่อยู่ในการติดต่อ"></textarea>
                            </div>
                            <div class="col-md-8">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">เบอร์โทรศัพท์</label>
                                        <input type="text" class="form-control" id="post-phone" placeholder="ตัวอย่าง: 0812345678" maxlength="10" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Line ID</label>
                                        <div class="position-relative">
                                            <input type="text" id="post-line-id" class="form-control" placeholder="ตัวอย่าง: username">
                                            <i class="bi position-absolute top-50 end-0 translate-middle-y me-3 text-muted small pointer-events-none"></i>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">Send To <span class="text-danger">*</span></label>
                                        <select class="form-select text-muted" id="post-send-to">
                                            <option value="" selected>เลือกผู้รับผิดชอบ</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-medium small">CC</label>
                                        <div class="dropdown custom-multi-select">
                                            <div class="form-select d-flex align-items-center justify-content-between" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="cc-display" style="cursor: pointer; min-height: 38px;">
                                                <div id="cc-tags-container" class="d-flex flex-wrap gap-1 w-100 align-items-center me-2">
                                                    <span class="text-muted" id="cc-placeholder">เลือก CC</span>
                                                </div>
                                            </div>
                                            <ul class="dropdown-menu w-100 p-1 shadow-sm" id="cc-dropdown-menu" style="max-height: 250px; overflow-y: auto;">
                                            </ul>
                                        </div>
                                        <select id="post-cc" multiple="multiple" class="d-none"></select>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-medium small">วันที่และเวลา (ให้ติดต่อกลับ)<span class="text-danger">*</span></label>
                                <div class="d-flex gap-2">
                                    <div class="position-relative flex-grow-1">
                                        <input type="date" class="form-control" id="post-contact-date">
                                    </div>
                                    <div class="position-relative" style="width: 120px;">
                                        <input type="time" class="form-control text-center" id="post-contact-time" value="00:00">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
