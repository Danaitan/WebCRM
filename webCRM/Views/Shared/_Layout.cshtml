@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Add Google Fonts (Prompt and Kanit for standard Thai UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Add Bootstrap for layout/utilities -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Add Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Add DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>

        /* @@keyframes bell-ring {
            0%, 100% { transform: rotate(0); }
            10%, 30%, 50% { transform: rotate(15deg); }
            20%, 40%, 60% { transform: rotate(-15deg); }
            70% { transform: rotate(0); }
        }
        .hover-ring:hover {
            animation: bell-ring 0.8s ease-in-out both;
            transform-origin: top center;
        } */

           @@keyframes bell-ring {
            0%   { transform: rotate(-15deg); }
            50%  { transform: rotate(15deg); }
            100% { transform: rotate(-15deg); }
        }

        .hover-ring {
            transform-origin: top center;
        }

        .hover-ring:hover {
            animation: bell-ring 1.2s ease-in-out infinite;
        }

        .notification-group [data-bs-toggle="collapse"] .bi-chevron-down {
            transition: transform 0.2s ease-in-out;
        }
        .notification-group [data-bs-toggle="collapse"][aria-expanded="true"] .bi-chevron-down {
            transform: rotate(180deg);
        }

    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="crm-body">
    @{
        bool hideSidebar = ViewData["HideSidebar"] as bool? == true;
        var currentPath = Context.Request.Path.Value ?? "/";
        string GetActiveClass(string path)
        {
            if (path == "/" || path == "/Home/Index")
            {
                return (currentPath == "/" || currentPath.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase)) ? "active-menu text-primary" : "text-secondary";
            }
            return (path != "#" && currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase)) ? "active-menu text-primary" : "text-secondary";
        }
    }

    <div class="d-flex" style="min-height: 100vh;">
        @if (!hideSidebar)
        {
            <!-- Sidebar -->
            <aside class="sidebar bg-white border-end d-flex flex-column flex-shrink-0" style="width: 260px; transition: all 0.3s;" id="crmSidebar">
                <!-- Sidebar Header (Title & Hide Button) -->
                <div class="px-3 py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="sidebar-text">
                        @* <img src="~/images/logo.png" class="mb-2" style="height: 52px; object-fit: contain;"> *@
                        <h5 class="fw-bold text-dark mb-0" style="color: var(--bs-primary, #0d6efd);">CRM 3.0</h5>
                    </div>
                    <button class="btn text-secondary d-flex align-items-center gap-2 p-0 border-0" id="hideSidebarBtn" style="font-size: 14px;">
                        <i class="bi bi-chevron-double-left fs-6" id="hideSidebarIcon"></i>
                    </button>
                </div>
                
                <!-- Menu Items -->
                <nav class="sidebar-nav flex-grow-1 px-2 py-3 d-flex flex-column gap-1 overflow-auto" id="sidebarNav">
                    <a href="/Home/Index" class="nav-link @GetActiveClass("/Home/Index") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-house fs-5"></i> <span class="fw-medium sidebar-text">Dashboard</span>
                    </a>
                    
                    <a href="/CustomerDetail" class="nav-link @GetActiveClass("/CustomerDetail") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-person fs-5"></i> <span class="fw-medium sidebar-text">ข้อมูลลูกค้า</span>
                    </a>
                    
                    <a href="/Suggestions" class="nav-link @GetActiveClass("/Suggestions") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-chat-dots fs-5"></i> <span class="fw-medium sidebar-text">ข้อเสนอแนะ/ร้องเรียน</span>
                    </a>

                    <a href="/Campain" class="nav-link @GetActiveClass("/Campain") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-megaphone fs-5"></i> <span class="fw-medium sidebar-text">Campaign Create</span>
                    </a>
                    
                    <a href="/ProspectSetup" class="nav-link @GetActiveClass("/ProspectSetup") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-people-fill fs-5"></i> <span class="fw-medium sidebar-text">Prospect Setup</span>
                    </a>
                    
                    <a href="/ProductApprove" class="nav-link @GetActiveClass("/ProductApprove") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-shield-check fs-5"></i> <span class="fw-medium sidebar-text">Campaign Approve</span>
                    </a>
                    
                    <a href="/ProspectAssign" class="nav-link @GetActiveClass("/ProspectAssign") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-people fs-5"></i> <span class="fw-medium sidebar-text">Prospect Assign</span>
                    </a>
                    
                    <a href="/ProspectCall" class="nav-link @GetActiveClass("/ProspectCall") d-flex align-items-center gap-3 px-3 py-2 rounded">
                        <i class="bi bi-telephone fs-5"></i> <span class="fw-medium sidebar-text">ขายและติดตาม</span>
                    </a>
                    
                </nav>
                
            </aside>
        }

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0; background-color: #f8fafc;">
            @{
                bool hideHeader = ViewData["HideHeader"] as bool? == true;
            }
            @if (!hideHeader)
            {
            <!-- Header -->
            <header class="crm-header d-flex align-items-center justify-content-between px-4 py-3 bg-white shadow-sm border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="ms-2">
                        <h4 class="mb-0 fw-bold text-dark-blue">@(ViewData["HeaderTitle"] ?? "CRM 3.0")</h4>
                        @if (ViewData["HeaderSubtitle"] != null)
                        {
                            <p class="text-muted small mb-0 mt-1">@ViewData["HeaderSubtitle"]</p>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="user-company text-end d-none d-md-block">
                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">Micro Leasing Public Company Limited</div>
                        <div class="text-muted" style="font-size: 0.85rem;">ยินดีต้อนรับ <span class="fw-bold text-primary">@(Context.Session.GetString("profile_welcome") ?? "")</span></div>
                    </div>
                    <div class="dropdown me-2">
                        <div class="position-relative d-flex align-items-center justify-content-center" style="cursor: pointer; width: 40px; height: 40px;" id="bellNotification" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="bi bi-bell fs-5 text-secondary hover-ring d-inline-block"></i>
                            <span id="notificationBadge" class="position-absolute badge rounded-pill bg-danger shadow-sm" style="top: 2px; right: 0px; font-size: 0.6rem; padding: 0.25em 0.4em; display: none;">
                                0
                            </span>
                        </div>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-0" aria-labelledby="bellNotification" style="width: 320px; border-radius: 12px; overflow: hidden; margin-top: 10px;">
                            <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, var(--bs-primary, #0d6efd) 0%, #3b82f6 100%);">
                                <h6 class="mb-0 fw-bold"><i class="bi bi-bell-fill me-2"></i>การแจ้งเตือน</h6>
                                <span class="badge bg-white text-primary rounded-pill shadow-sm" id="notificationHeaderCount">0</span>
                            </div>
                            <div id="notificationList" class="overflow-auto bg-white" style="max-height: 350px;">
                                <!-- Notification items will be appended here -->
                            </div>
                            <div class="p-2 text-center border-top" style="background-color: #f8fafc;">
                                <a href="#" class="text-primary text-decoration-none small fw-medium" data-bs-toggle="modal" data-bs-target="#allNotificationsModal">ดูการแจ้งเตือนทั้งหมด</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            }

            <div class="content-wrapper flex-grow-1 overflow-auto">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- All Notifications Modal -->
    <div class="modal fade" id="allNotificationsModal" tabindex="-1" aria-labelledby="allNotificationsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; max-height: 85vh;">
                <div class="modal-header text-white border-0" style="background: linear-gradient(135deg, var(--bs-primary, #0d6efd) 0%, #3b82f6 100%); border-radius: 12px 12px 0 0;">
                    <h5 class="modal-title fw-bold" id="allNotificationsModalLabel"><i class="bi bi-bell-fill me-2"></i>การแจ้งเตือนทั้งหมด</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0" style="background-color: #f8fafc; overflow: hidden;">
                    <div class="row g-0" style="min-height: 480px; max-height: 72vh;">
                        <!-- Left Pane: List of items -->
                        <div class="col-12 col-md-5 border-end overflow-auto p-3" id="allNotificationsModalBody" style="max-height: 72vh; background-color: #f8fafc;">
                            <!-- Modal notifications will be appended here -->
                        </div>
                        <!-- Right Pane: Detail view -->
                        <div class="col-12 col-md-7 overflow-auto p-4 bg-white" id="allNotificationsModalDetail" style="max-height: 72vh;">
                            <!-- Notification detail will be loaded here -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top d-flex justify-content-between align-items-center px-3 py-2" style="border-radius: 0 0 12px 12px;">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-2 shadow-sm transition-all" onclick="deleteReadNotifications()">
                        <i class="bi bi-trash3-fill"></i>
                        <span class="fw-medium">ลบที่อ่านแล้วทั้งหมด</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">
                        ปิด
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Detail Popup Modal -->
    <div class="modal fade" id="notificationDetailModal" tabindex="-1" aria-labelledby="notificationDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header text-white border-0" style="background: linear-gradient(135deg, var(--bs-primary, #0d6efd) 0%, #3b82f6 100%);">
                    <h5 class="modal-title fw-bold" id="notificationDetailModalLabel">
                        <i class="bi bi-bell-fill me-2"></i>รายละเอียดการแจ้งเตือน
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 bg-white" id="notificationDetailModalBody" style="max-height: 70vh; overflow-y: auto;">
                    <!-- Notification details will be loaded here -->
                </div>
                <div class="modal-footer bg-light border-top d-flex justify-content-between align-items-center px-3 py-2">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1 shadow-sm" id="notiDetailDeleteBtn">
                        <i class="bi bi-trash3-fill"></i>
                        <span>ลบ</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">
                        ปิด
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Loading Overlay -->
    <partial name="~/Views/Component/Loading.cshtml" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        var personalId = Context.Session.GetString("personalId");
        if (string.IsNullOrWhiteSpace(personalId))
        {
            var profileWelcome = Context.Session.GetString("profile_welcome") ?? "";
            var match = System.Text.RegularExpressions.Regex.Match(profileWelcome, @"\[(.*?)\]");
            personalId = match.Success ? match.Groups[1].Value : profileWelcome;
        }
        var apiDomain = Environment.GetEnvironmentVariable("ApiSettings__APIDomain") 
                        ?? Configuration["ApiSettings:APIDomain"] 
                        ?? Configuration.GetSection("ApiSettings")["APIDomain"] 
                        ?? "";
    }
    <script>
        var userId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(personalId ?? ""));
        var apiDomain = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiDomain ?? ""));
        var currentUserEmail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("email") ?? ""));
        var userFullNameEn = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("fullNameEn") ?? ""));
        var userFullNameTh = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("fullNameTh") ?? ""));
    </script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
