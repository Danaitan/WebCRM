@{
    ViewData["Title"] = "Campaign Approve";
    ViewData["HeaderTitle"] = "Campaign Approve";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productApprove.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
}

<div class="pa-page-wrapper">
    <!-- Top Search & Filter Bar -->
    <div class="pa-top-filter-bar">
        <div class="pa-filter-row">
            <div class="pa-filter-col pa-filter-search">
                <label class="pa-filter-label"><i class="bi bi-search me-1"></i> ค้นหา Campaign</label>
                <div class="pa-search-input-group">
                    <i class="bi bi-search"></i>
                    <input type="text" id="campaignSearch" class="pa-form-control bg-white" placeholder="ค้นหาแคมเปญ / รหัสแคมเปญ">
                </div>
            </div>

            <div class="pa-filter-col">
                <label class="pa-filter-label"><i class="bi bi-calendar-event me-1"></i> วันที่เริ่มต้น</label>
                <div class="pa-form-control-icon">
                    <input type="text" id="filterStartDate" class="pa-form-control bg-white" placeholder="วว/ดด/ปปปป" readonly>
                </div>
            </div>

            <div class="pa-filter-col">
                <label class="pa-filter-label"><i class="bi bi-calendar-event me-1"></i> วันที่สิ้นสุด</label>
                <div class="pa-form-control-icon">
                    <input type="text" id="filterEndDate" class="pa-form-control bg-white" placeholder="วว/ดด/ปปปป" readonly>
                </div>
            </div>

            <div class="pa-filter-col">
                <label class="pa-filter-label"><i class="bi bi-flag me-1"></i> สถานะ</label>
                <select id="filterStatus" class="pa-form-control bg-white">
                    <option value="">ทั้งหมด</option>
                    <option value="waiting approve">waiting approve</option>
                    <option value="approved">approved</option>
                </select>
            </div>

            <div class="pa-filter-col">
                <label class="pa-filter-label"><i class="bi bi-building me-1"></i> สาขา</label>
                <select id="filterBranch" class="pa-form-control bg-white">
                    <option value="">ทั้งหมด</option>
                </select>
            </div>

            <div class="pa-filter-col pa-filter-actions">
                <button type="button" class="btn btn-primary" id="btnSearch">
                    <i class="bi bi-search"></i> ค้นหา
                </button>
                <button type="button" class="btn-pa-clear" id="btnClearFilter">
                    <i class="bi bi-arrow-counterclockwise"></i> ล้างเงื่อนไข
                </button>
            </div>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="pa-layout">
        <!-- Left Sidebar -->
        <div class="pa-sidebar-left">
            <div class="pa-sidebar-header">
                <h5>รายการแคมเปญ</h5>
                <div class="badge-count" id="campaignCount">0</div>
            </div>

            <div class="mb-3">
                <select id="campaignStatusFilter"
                        class="form-select"
                        style="border-radius: 10px; height: 42px; font-size: 0.875rem; border: 1px solid #e2e8f0; background-color: #fff; cursor: pointer;">
                    <option value="">ทั้งหมด</option>
                </select>
            </div>
                    
            <div class="campaign-table-wrapper flex-grow-1 overflow-hidden d-flex flex-column">
                <table id="campaignsTable" class="table table-borderless" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- Right Container -->
        <div class="pa-right-container">
            <!-- Content Wrapper (Main Area) -->
            <div class="pa-content-wrapper">
                
                <!-- Main Area -->
                <div class="pa-main-area">
                    <div class="pa-section pa-campaign-detail-section">
                        <div class="pa-section-title">
                            <i class="bi bi-clipboard2-check"></i> ข้อมูล Campaign
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-lg-6 col-xl-4 pa-form-group">
                                <label>รหัส Campaign</label>
                                <input type="text" id="detailId" class="pa-form-control" value="APP-0001" readonly>
                            </div>
                            <div class="col-12 col-lg-6 col-xl-4 pa-form-group">
                                <label>ชื่อ Campaign</label>
                                <input type="text" id="detailName" class="pa-form-control" value="" readonly>
                            </div>
                            <div class="col-12 col-lg-6 col-xl-4 pa-form-group">
                                <label>วัตถุประสงค์</label>
                                <input type="text" id="detailObjective" class="pa-form-control" value="" readonly>
                            </div>
                            <div class="col-12 col-lg-6 col-xl-6 pa-form-group">
                                <label>วันที่เริ่มต้น</label>
                                <div class="pa-form-control-icon">
                                    <input type="text" id="detailStart" class="pa-form-control" value="" readonly>
                                    <i class="bi bi-calendar"></i>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 col-xl-6 pa-form-group">
                                <label>วันที่สิ้นสุด</label>
                                <div class="pa-form-control-icon">
                                    <input type="text" id="detailEnd" class="pa-form-control" value="" readonly>
                                    <i class="bi bi-calendar"></i>
                                </div>
                            </div>

                            <div class="col-12 pa-form-group mb-0">
                                <label>รายละเอียดแคมเปญ</label>
                                <textarea id="detailNote" class="pa-form-control" rows="2" readonly placeholder="-" style="resize: none;"></textarea>
                            </div>

                            <div id="detailRemarkGroup" class="col-12 pa-form-group mb-0">
                                <label>หมายเหตุ</label>
                                <textarea id="detailRemark"
                                        class="pa-form-control"
                                        rows="2"
                                        readonly
                                        placeholder="-"
                                        style="resize: none;"></textarea>
                            </div>

                            <div class="col-12 mt-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <div id="selectedFileNameDisplay" class="d-none align-items-center gap-2 px-3 py-1 bg-light border rounded" style="font-size: 0.875rem;">
                                        <i class="bi bi-file-earmark-text text-primary fs-5"></i>
                                        <span id="selectedFileNameText" class="fw-medium text-dark"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="pa-section pa-prospect-section d-flex flex-column">
                        <div class="pa-prospect-header">
                            <div class="pa-section-title mb-0">
                                <i class="bi bi-people"></i> รายละเอียด Prospect
                                <span class="badge bg-primary rounded-pill fs-7 ms-2" id="prospectApproveTotalBadge">ทั้งหมด 0 รายการ</span>
                            </div>
                        </div>
                        
                        <div class="pa-table-responsive-wrapper">
                            <table class="pa-table" id="prospectApproveTable">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">ลำดับ</th>
                                        <th>สาขา</th>
                                        <th>ชื่อ-นามสกุล</th>
                                        <th>เลขที่สัญญา</th>
                                        <th>สถานที่ใช้รถ</th>
                                        <th>วันที่เลือกข้อมูล</th>
                                    </tr>
                                </thead>
                                <tbody id="prospectTableBody">
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="bi bi-hourglass-split me-1"></i> กำลังโหลดข้อมูล...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="pa-table-pagination">
                            <span id="prospectPaginationText">แสดง 0 จาก 0 รายการ</span>
                            <div class="d-flex align-items-center gap-3">
                                <div class="pa-page-controls" id="prospectPaginationControls">
                                    <button class="pa-page-btn" id="prospectPrevBtn" disabled><i class="bi bi-chevron-left"></i></button>
                                    <button class="pa-page-btn active">1</button>
                                    <button class="pa-page-btn" id="prospectNextBtn" disabled><i class="bi bi-chevron-right"></i></button>
                                </div>
                                <select class="pa-form-control" id="prospectPageSizeSelect" style="width: auto; padding: 0.25rem 2rem 0.25rem 0.75rem;">
                                    <option value="5" selected>5 / หน้า</option>
                                    <option value="10">10 / หน้า</option>
                                    <option value="20">20 / หน้า</option>
                                    <option value="50">50 / หน้า</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>

            <!-- Action Footer -->
            <div class="pa-action-bar">
                <button type="button" class="btn-pa btn-pa-approve" id="btnApprove" disabled><i class="bi bi-check2"></i> อนุมัติ</button>
                <button type="button" class="btn-pa btn-pa-reject" id="btnReject" disabled><i class="bi bi-x-lg"></i> ไม่อนุมัติ</button>
                <button type="button" class="btn-pa btn-pa-return" id="btnReturn" disabled>ส่งกลับแก้ไข</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/productApprove.js" asp-append-version="true"></script>
}
