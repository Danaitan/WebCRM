@{
    ViewData["Title"] = "Dashboard";
    ViewData["HeaderTitle"] = "Dashboard";
    ViewData["HideSidebar"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="pc-wrapper">
    <div class="pc-tab-content active" id="tab3">
        <div class="pc-report-wrapper">
            <!-- Filter Bar -->
            <div class="pc-card p-4 flex-shrink-0">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">มุมมอง Dashboard</label>
                        <select class="form-select form-select-sm" onchange="if(this.value) window.location.href=this.value;">
                            <option value="@Url.Action("Index", "Home")" selected>ข้อมูลลูกค้า</option>
                            <option value="@Url.Action("Index", "DashboardProspectCall")">การติดต่อลูกค้า</option>
                            <option value="@Url.Action("Index", "DashboardSuggestion")">ข้อเสนอแนะ/ร้องเรียน</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">สาขา</label>
                        <select class="form-select form-select-sm" onchange="if(this.value) window.location.href=this.value;">

                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">ประเภทลูกค้า</label>
                        <select class="form-select form-select-sm" onchange="if(this.value) window.location.href=this.value;">

                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">เพศ</label>
                        <select class="form-select form-select-sm" onchange="if(this.value) window.location.href=this.value;">

                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label text-muted small">สถานะสัญญา</label>
                        <select class="form-select form-select-sm" onchange="if(this.value) window.location.href=this.value;">

                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3 justify-content-end">
                    <button class="btn btn-primary btn-sm px-3"><i class="bi bi-search me-2"></i>ค้นหา</button>
                    <button class="btn btn-outline-secondary btn-sm px-3"><i class="bi bi-arrow-counterclockwise me-2"></i>ล้างตัวกรอง</button>
                </div>

            </div>

            @* การ์ดจำนวนลูกค้า *@
            <div class="customer-stats-grid">
                <!-- Card 1: ลูกค้าทั้งหมด -->
                <div class="customer-stat-card card-blue">
                    <div class="stat-card-main">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="stat-info">
                            <div class="stat-title">ลูกค้าทั้งหมด</div>
                            <div class="stat-value-group">
                                <span class="stat-value" id="statTotalCount">0</span>
                                <span class="stat-unit">ราย</span>
                            </div>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <span>&nbsp;</span>
                    </div>
                </div>

                <!-- card บริษัท -->
                <div id="customerCard">
                </div>

            </div>

            <div class="customer-graph">

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="productChart"></canvas>
                    </div>
                </div>

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="occupationChart"></canvas>
                    </div>
                </div>

                <div class="pc-card chart-card p-3 p-md-4">
                    <div class="chart-container">
                        <canvas id="ageChart"></canvas>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.CURRENT_COMPANY = '@(Context.Session.GetString("company") ?? "")';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Home.js" asp-append-version="true"></script>
}
